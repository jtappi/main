{
  "name": "trackmyweek",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/unit/**/*.test.js"],
    "collectCoverageFrom": [
      "lib/**/*.js",
      "controllers/**/*.js",
      "!**/node_modules/**",
      "!lib/data.js"
    ],
    "coverageReporters": ["text", "lcov", "json-summary"],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 95,
        "lines": 90
      },
      "./controllers/prebuilt.controller.js": {
        "branches": 80,
        "functions": 100,
        "lines": 90
      }
    }
  }
}
