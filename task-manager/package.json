{
  "name": "task-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Local to-do list app mounted in the portal at /task-manager",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "server.js"
    ],
    "coverageReporters": ["text", "lcov", "json-summary"],
    "coverageDirectory": "coverage"
  }
}
